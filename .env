# Configurações do Servidor
ENVIRONMENT=development
PORT=8000
LOG_LEVEL=info

# Segurança JWT (Chave utilizada para validar os tokens do sistema chamador - min 32 bytes)
JWT_SECRET_KEY=chave_secreta_teste_local_1234567890_super_longa_32_bytes
JWT_ALGORITHM=HS256

# Configurações de IA (Fallback Exclusivo Mistral AI)
MISTRAL_API_KEY=mistral_api_key_teste_local_12345
